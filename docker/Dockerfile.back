# ─── Stage 1: builder ────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

ENV POETRY_VERSION=1.8.5 \
  POETRY_VIRTUALENVS_IN_PROJECT=true \
  POETRY_NO_INTERACTION=1 \
  PIP_NO_CACHE_DIR=off \
  PIP_DISABLE_PIP_VERSION_CHECK=on

RUN pip install "poetry==$POETRY_VERSION"

WORKDIR /payolin

ENV PATH="/payolin/.venv/bin:$PATH"

COPY poetry.lock pyproject.toml ./

RUN poetry install --only main --no-root

# ─── Stage 2: runtime ────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
  PYTHONHASHSEED=random \
  PATH="/payolin/.venv/bin:$PATH"

WORKDIR /payolin

COPY --from=builder /payolin/.venv .venv

COPY . .

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN adduser --disabled-password --no-create-home docker-admin
USER docker-admin

EXPOSE 8888

CMD ["uvicorn", "src.main:create_app", "--host", "0.0.0.0", "--port", "8888", "--workers", "4"]
