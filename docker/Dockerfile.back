# The API container intentionally does not install vLLM/CUDA. vLLM is used by
# the separate local voice process; keeping it out makes this web container
# small enough to build and start quickly.
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
  PYTHONHASHSEED=random \
  PATH="/payolin/.venv/bin:$PATH"

WORKDIR /payolin

RUN python -m venv /payolin/.venv \
  && /payolin/.venv/bin/pip install --no-cache-dir \
    aiohttp alembic asyncpg bcrypt cryptography dishka fastapi httpx \
    msgspec orjson pydantic pydantic-settings pyjwt pyotp python-dateutil \
    pytz redis sqlalchemy taskiq taskiq-redis typer typing-extensions uuid6 uvicorn websockets

COPY . .

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN adduser --disabled-password --no-create-home docker-admin
USER docker-admin

EXPOSE 8888

CMD ["uvicorn", "src.entrypoint.main:create_app", "--host", "0.0.0.0", "--port", "8888", "--workers", "4"]
